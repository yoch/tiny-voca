+// real FFT of n samples (a power of two, 8 <= n <= 512) as an iterative radix-2 complex FFT of m = n / 2 points
+struct tiny_voca_rfft {
+    int m;
+    std::vector<int>   rev;          // bit reversal of 0 .. m - 1
+    std::vector<float> tw_c, tw_s;   // twiddles of the stage of size 2 h at h - 1 + j: exp(-i pi j / h)
+    std::vector<float> rot_c, rot_s; // exp(-2 pi i k / n), k = 0 .. m - 1
+
+    explicit tiny_voca_rfft(int n) : m(n / 2), rev(m), tw_c(m), tw_s(m), rot_c(m), rot_s(m) {
+        GGML_ASSERT(n >= 8 && n <= 512 && (n & (n - 1)) == 0);
+        for (int k = 0; k < m; k++) {
+            for (int b = m / 2, i = k; b > 0; b >>= 1, i >>= 1) {
+                rev[k] = 2 * rev[k] + (i & 1);
+            }
+        }
+        for (int h = 1; h < m; h *= 2) {
+            for (int j = 0; j < h; j++) {
+                tw_c[h - 1 + j] = std::cos(-M_PI * j / h);
+                tw_s[h - 1 + j] = std::sin(-M_PI * j / h);
+            }
+        }
+        for (int k = 0; k < m; k++) {
+            rot_c[k] = std::cos(-2.0 * M_PI * k / n);
+            rot_s[k] = std::sin(-2.0 * M_PI * k / n);
+        }
+    }
+
+    void butterflies(float * r, float * im) const {
+        // stages of size 2 and 4 together, their twiddles are 1 and -i
+        for (int a = 0; a < m; a += 4) {
+            const float r0 = r[a] + r[a + 1],     i0 = im[a] + im[a + 1],     r1 = r[a] - r[a + 1],     i1 = im[a] - im[a + 1];
+            const float r2 = r[a + 2] + r[a + 3], i2 = im[a + 2] + im[a + 3], r3 = r[a + 2] - r[a + 3], i3 = im[a + 2] - im[a + 3];
+            r[a]     = r0 + r2; im[a]     = i0 + i2;
+            r[a + 2] = r0 - r2; im[a + 2] = i0 - i2;
+            r[a + 1] = r1 + i3; im[a + 1] = i1 - r3;
+            r[a + 3] = r1 - i3; im[a + 3] = i1 + r3;
+        }
+        for (int h = 4; h < m; h *= 2) {
+            const float * c = tw_c.data() + h - 1;
+            const float * s = tw_s.data() + h - 1;
+            for (int block = 0; block < m; block += 2 * h) {
+                for (int j = 0; j < h; j++) {
+                    const int   a  = block + j, b = a + h;
+                    const float tr = r[b] * c[j] - im[b] * s[j];
+                    const float ti = r[b] * s[j] + im[b] * c[j];
+                    r[b] = r[a] - tr; im[b] = im[a] - ti;
+                    r[a] += tr;       im[a] += ti;
+                }
+            }
+        }
+    }
+
+    // x: n samples -> X: m + 1 bins (interleaved complex)
+    void forward(const float * x, float * X) const {
+        float r[256], im[256];
+        for (int j = 0; j < m; j++) {
+            r[j]  = x[2 * rev[j]];
+            im[j] = x[2 * rev[j] + 1];
+        }
+        butterflies(r, im);
+        X[0] = r[0] + im[0];
+        X[1] = 0.0f;
+        X[2 * m] = r[0] - im[0];
+        X[2 * m + 1] = 0.0f;
+        for (int k = 1; k < m; k++) {
+            const float dr = r[k] - r[m - k], di = im[k] + im[m - k];
+            X[2 * k]     = 0.5f * (r[k] + r[m - k] + di * rot_c[k] + dr * rot_s[k]);
+            X[2 * k + 1] = 0.5f * (im[k] - im[m - k] - dr * rot_c[k] + di * rot_s[k]);
+        }
+    }
+
+    // X: m + 1 bins with zero imaginary parts at DC and Nyquist -> y: n samples, scaled by 1 / n
+    void inverse(const float * X, float * y) const {
+        float r[256], im[256];
+        for (int j = 0; j < m; j++) {
+            const int   k  = rev[j], o = m - k;
+            const float dr = X[2 * k] - X[2 * o], di = X[2 * k + 1] + X[2 * o + 1];
+            r[j]  =  0.5f * (X[2 * k] + X[2 * o] - di * rot_c[k] + dr * rot_s[k]);
+            im[j] = -0.5f * (X[2 * k + 1] - X[2 * o + 1] + dr * rot_c[k] + di * rot_s[k]);
+        }
+        butterflies(r, im);
+        for (int j = 0; j < m; j++) {
+            y[2 * j]     =  r[j] / m;
+            y[2 * j + 1] = -im[j] / m;
+        }
+    }
+};
